# Copier en .env à la racine du projet sur le VPS :  cp .env.production.example .env
# puis remplacer toutes les valeurs « A_CHANGER ».

# --- Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=A_CHANGER
DJANGO_ALLOWED_HOSTS=billeteriecjics.com,www.billeteriecjics.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://billeteriecjics.com,https://www.billeteriecjics.com

# --- Billets et accès personnel
TICKET_SIGNING_KEY=A_CHANGER
STAFF_ACCESS_CODE=A_CHANGER

# --- Base de données (conteneur MariaDB)
DB_NAME=billetterie
DB_USER=billetterie
DB_PASSWORD=A_CHANGER
DB_ROOT_PASSWORD=A_CHANGER

# --- Paiement
WAVE_MERCHANT_URL=https://pay.wave.com/m/M_sn_VU2qAQOJ_dLv/c/sn/
# 1 = démonstration : « Payer avec Wave » valide le paiement sans débit (billet sans payer)
# 0 = vraies ventes via le lien marchand Wave + vérification dans le tableau de bord
# Passer à 0 avant d'ouvrir la vente au public, puis : docker compose up -d
PAIEMENT_SIMULE=1
